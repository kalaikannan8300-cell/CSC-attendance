# Neon PostgreSQL connection string; use the pooled URL in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Provisioned once on an empty database by npm run db:setup. Use a unique secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-random-password-of-at-least-16-characters

# Local API settings. Render provides PORT automatically in production.
API_PORT=3001
NODE_ENV=development

# Persistent promotional image storage (Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sheets service account. Share each monthly sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Store the PEM value with literal \n separators in deployment settings.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
